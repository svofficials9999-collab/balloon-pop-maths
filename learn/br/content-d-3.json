audio_ids":{"question":{"te":"br_q_d_6_question","en":"br_q_d_6_question__en"},"answer":{"te":"br_q_d_6_answer","en":"br_q_d_6_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_d_7","type":"mcq","prompt":{"te":"రాష్ట్రపతి ఎన్నికకు కనీస వయసు ఎంత?","en":"What is the minimum age for election as President?"},"options":[{"te":"35","en":"35 years"},{"te":"25","en":"25 years"},{"te":"30","en":"30 years"},{"te":"40","en":"40 years"}],"answer_index":0,"explanation":{"te":"పాఠం: 58(1)(b) thirty-five years.","en":"Text: Article 58(1)(b), thirty-five years."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_58"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_d_7_question","en":"br_q_d_7_question__en"},"answer":{"te":"br_q_d_7_answer","en":"br_q_d_7_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_d_8","type":"mcq","prompt":{"te":"58వ అధికరణం ప్రకారం ఎన్నికకు అనర్హత ఏది?","en":"Under Article 58, which disqualifies a person from election as President?"},"options":[{"te":"లాభదాయక పదవి కలిగి ఉండటం","en":"Holding an office of profit"},{"te":"మంత్రిగా ఉండటం","en":"Being a Minister"},{"te":"గవర్నర్‌గా ఉండటం","en":"Being a Governor"},{"te":"ఉపరాష్ట్రపతిగా ఉండటం","en":"Being the Vice-President"}],"answer_index":0,"explanation":{"te":"పాఠం: 58(2). వివరణ ప్రకారం రాష్ట్రపతి, ఉపరాష్ట్రపతి, గవర్నర్, మంత్రి పదవులు లాభదాయక పదవులు కావు.","en":"Text: Article 58(2). The Explanation says the offices of President, Vice-President, Governor and Minister are not offices of profit for this purpose."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_58"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_d_8_question","en":"br_q_d_8_question__en"},"answer":{"te":"br_q_d_8_answer","en":"br_q_d_8_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_d_9","type":"true_false","prompt":{"te":"సత్యమా/అసత్యమా: 59(4) ప్రకారం రాష్ట్రపతి పదవీకాలంలో ఆయన వేతనాలు, భత్యాలను తగ్గించవచ్చు.","en":"True or false: under Article 59(4), the President's emoluments and allowances may be diminished during the term."},"options":[{"te":"సత్యం","en":"True"},{"te":"అసత్యం","en":"False"}],"answer_index":1,"explanation":{"te":"అసత్యం. 59(4): తగ్గించరాదు.","en":"False. Article 59(4): they shall not be diminished during the term."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_59"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_d_9_question","en":"br_q_d_9_question__en"},"answer":{"te":"br_q_d_9_answer","en":"br_q_d_9_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_d_10","type":"mcq","prompt":{"te":"రాష్ట్రపతి చేత ప్రమాణం ఎవరి సమక్షంలో చేయాలి?","en":"In whose presence does the President make the oath or affirmation?"},"options":[{"te":"భారత ప్రధాన న్యాయమూర్తి, లేదా ఆయన లేకపోతే సుప్రీంకోర్టు సీనియర్ న్యాయమూర్తి","en":"The Chief Justice of India or, in the Chief Justice's absence, the senior-most Supreme Court Judge available"},{"te":"ప్రధానమంత్రి","en":"The Prime Minister"},{"te":"లోక్‌సభ స్పీకర్","en":"The Speaker"},{"te":"ఉపరాష్ట్రపతి","en":"The Vice-President"}],"answer_index":0,"explanation":{"te":"పాఠం: 60.","en":"Text: Article 60."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_60"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_d_10_question","en":"br_q_d_10_question__en"},"answer":{"te":"br_q_d_10_answer","en":"br_q_d_10_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_d_11","type":"mcq","prompt":{"te":"రాష్ట్రపతి అభిశంసన కోసం తీర్మానం ప్రతిపాదించే ముందు ఎంత నోటీసు అవసరం?","en":"How much written notice is required before moving a resolution to impeach the President?"},"options":[{"te":"కనీసం పద్నాలుగు రోజులు","en":"At least fourteen days"},{"te":"ఏడు రోజులు","en":"Seven days"},{"te":"ముప్పై రోజులు","en":"Thirty days"},{"te":"నోటీసు అవసరం లేదు","en":"No notice"}],"answer_index":0,"explanation":{"te":"పాఠం: 61(2)(a) at least fourteen days notice signed by not less than one-fourth of members.","en":"Text: Article 61(2)(a), at least fourteen days notice signed by not less than one-fourth of the members."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_61"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_d_11_question","en":"br_q_d_11_question__en"},"answer":{"te":"br_q_d_11_answer","en":"br_q_d_11_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_d_12","type":"mcq","prompt":{"te":"61వ అధికరణం ప్రకారం అభిశంసన తీర్మానానికి ఎంత మెజారిటీ కావాలి?","en":"What majority does Article 61 require for the impeachment resolution?"},"options":[{"te":"మొత్తం సభ్యత్వంలో కనీసం మూడింట రెండొంతులు","en":"Not less than two-thirds of the total membership"},{"te":"సాధారణ మెజారిటీ","en":"Simple majority"},{"te":"హాజరైన వారిలో సగం","en":"Half of those present"},{"te":"ముప్పావు వంతు","en":"Three-fourths"}],"answer_index":0,"explanation":{"te":"పాఠం: 61(2)(b), 61(4).","en":"Text: Article 61(2)(b) and 61(4)."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_61"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_d_12_question","en":"br_q_d_12_question__en"},"answer":{"te":"br_q_d_12_answer","en":"br_q_d_12_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_d_13","type":"mcq","prompt":{"te":"పదవీకాలం ముగియడం కాకుండా మరణం లేదా రాజీనామా వల్ల ఖాళీ వస్తే ఎన్నిక ఎంత లోపల జరగాలి?","en":"For a vacancy caused by death or resignation, within what time must the election be held?"},"options":[{"te":"ఖాళీ నుండి ఆరు నెలల లోపు","en":"Within six months of the vacancy"},{"te":"ఒక నెల లోపు","en":"Within one month"},{"te":"ఒక సంవత్సరం లోపు","en":"Within one year"},{"te":"పదిహేను రోజుల లోపు","en":"Within fifteen days"}],"answer_index":0,"explanation":{"te":"పాఠం: 62(2) in no case later than six months.","en":"Text: Article 62(2), in no case later than six months."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_62"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_d_13_question","en":"br_q_d_13_question__en"},"answer":{"te":"br_q_d_13_answer","en":"br_q_d_13_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_d_14","type":"mcq","prompt":{"te":"53వ అధికరణం ప్రకారం రక్షణ దళాల సర్వోన్నత నాయకత్వం ఎవరికి?","en":"Under Article 53, in whom is the supreme command of the Defence Forces vested?"},"options":[{"te":"రాష్ట్రపతి","en":"The President"},{"te":"ప్రధానమంత్రి","en":"The Prime Minister"},{"te":"రక్షణ మంత్రి","en":"The Defence Minister"},{"te":"సుప్రీంకోర్టు","en":"The Supreme Court"}],"answer_index":0,"explanation":{"te":"పాఠం: 53(2). వినియోగం చట్టం ద్వారా నియంత్రించబడుతుంది.","en":"Text: Article 53(2). Its exercise is regulated by law."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_53"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_d_14_question","en":"br_q_d_14_question__en"},"answer":{"te":"br_q_d_14_answer","en":"br_q_d_14_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}}]}}
