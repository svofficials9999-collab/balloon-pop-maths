en":"2011"}],"answer_index":0,"explanation":{"te":"పాఠం: construed as a reference to the 1971 census.","en":"Text: construed as a reference to the 1971 census."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_55"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_d_3_question","en":"br_q_d_3_question__en"},"answer":{"te":"br_q_d_3_answer","en":"br_q_d_3_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_d_4","type":"mcq","prompt":{"te":"రాష్ట్రపతి పదవీకాలం ఎంత?","en":"What is the term of office of the President?"},"options":[{"te":"ఐదు సంవత్సరాలు","en":"Five years"},{"te":"నాలుగు సంవత్సరాలు","en":"Four years"},{"te":"ఆరు సంవత్సరాలు","en":"Six years"},{"te":"జీవితకాలం","en":"For life"}],"answer_index":0,"explanation":{"te":"పాఠం: 56(1) five years from the date on which he enters upon his office.","en":"Text: Article 56(1), five years from the date of entering upon office."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_56"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_d_4_question","en":"br_q_d_4_question__en"},"answer":{"te":"br_q_d_4_answer","en":"br_q_d_4_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_d_5","type":"mcq","prompt":{"te":"రాష్ట్రపతి రాజీనామా ఎవర