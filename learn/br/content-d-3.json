 services of the State.","en":"Text: separate the judiciary from the executive in the public services of the State."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_50"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_c_14_question","en":"br_q_c_14_question__en"},"answer":{"te":"br_q_c_14_answer","en":"br_q_c_14_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_c_15","type":"mcq","prompt":{"te":"51వ అధికరణంలో వివాదాల పరిష్కారానికి ఏ మార్గాన్ని ప్రోత్సహించాలి?","en":"Which method of settling international disputes does Article 51 encourage?"},"options":[{"te":"మధ్యవర్తిత్వం (ఆర్బిట్రేషన్)","en":"Arbitration"},{"te":"యుద్ధం","en":"War"},{"te":"ఆంక్షలు","en":"Sanctions"},{"te":"ఓటింగ్","en":"Voting"}],"answer_index":0,"explanation":{"te":"పాఠం: encourage settlement of international disputes by arbitration.","en":"Text: (d) encourage settlement of international disputes by arbitration."},"difficulty":"basic","exam_categories":["UPSC_style","SSC_style","TGPSC_style"],"source_kind":"original_authored_practice_not_previous_year_question","related_entity_ids":["br_art_51"],"answer_release_policy":"after_submission_or_explicit_reveal","reference_ids":["ref_const_2026"],"last_verified_date":"2026-10-09","content_status":"authored_source_checked_partial","revision":1,"audio_ids":{"question":{"te":"br_q_c_15_question","en":"br_q_c_15_question__en"},"answer":{"te":"br_q_c_15_answer","en":"br_q_c_15_answer__en"}},"field_verification":{"explanation":{"state":"authored_educational_paraphrase","reference_ids":["ref_const_2026"]}}},{"id":"br_q_c_16","type":"true_false","prompt":{"te